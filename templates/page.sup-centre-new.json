        "content-2": {
          "type": "content",
          "settings": {
            "image": "shopify://shop_images/Pro_In_the_box_New26.jpg",
            "subheading": "2022",
            "heading": "<strong>The range grows beyond the board.  </strong>",
            "heading_tag": "h2",
            "text": "<p>Paddleboards are joined by inflatable kayaks, canoes and a full kit list — pumps, paddles, bags, robes and safety gear -so a first-timer can buy everything for a day on the water in a single order.</p>",
            "button_label": "",
            "button_link": "",
            "button_style": "primary",
            "button_external": false,
            "button_icon": true,
            "highlighted_text": "none",
            "highlighted_scribble": "circle",
