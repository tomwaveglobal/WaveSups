{%- doc -%}
  Wraps Shopify's own policy markup (/policies/*) in the Wave FY27 look.
  Styles: assets/wave-policy.css; "On this page" contents: assets/wave-doc.js.

  Rendered twice from layout/theme.liquid around content_for_layout: 'start'
  adds the hero with the policy title and tabs for every published policy,
  'end' closes it and adds the contact card.

  @param {string} part - 'start' or 'end'
{%- enddoc -%}

{%- liquid
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
-%}

{%- capture help_card -%}
  <div class="wp-help">
    <div class="wp__inner">
      <div class="wp-help__card">
        <div>
          <h2 class="wp-help__title">Still got a <em>question?</em></h2>
          <p class="wp-help__text">
            If something here isn't clear, our support team will talk you through it.
          </p>
        </div>
        <a class="wp-help__button" href="{{ root }}/pages/contact-us">
          Contact us
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
{%- endcapture -%}

{%- if part == 'start' -%}
  {%- liquid
    assign current_title = page_title
    for policy in shop.policies
      if request.path contains policy.url
        assign current_title = policy.title
      endif
    endfor

    assign words = current_title | escape | split: ' '
    if words.size > 1
      assign last_word = words | last
      assign lead_size = words.size | minus: 1
      assign lead = words | slice: 0, lead_size | join: ' '
      assign title_html = lead | append: ' <em>' | append: last_word | append: '</em>'
    else
      assign title_html = '<em>' | append: words.first | append: '</em>'
    endif
  -%}
  <div class="wp">
    <div class="wp-hero">
      <div class="wp__inner">
        <p class="wp-eyebrow">Policies</p>
        <h1 class="wp-title">
          {%- render 'highlighted-text', content: title_html, style: 'scribble', scribble: 'basic-underline' -%}
        </h1>
        <p class="wp-lede">The small print for shopping with {{ shop.name | escape }}, written to be clear.</p>

        {%- if shop.policies.size > 1 -%}
          <nav aria-label="Policies">
            <ul class="wp-tabs" role="list">
              {%- for policy in shop.policies -%}
                <li>
                  <a
                    href="{{ policy.url }}"
                    {% if request.path contains policy.url %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- policy.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    </div>
    <div class="wp-policy">
{%- elsif part == 'end' -%}
    </div>
    {{ help_card }}
  </div>

  <script>
    (() => {
      // Keep the current policy's tab in view when the tabs scroll sideways
      const tab = document.querySelector('.wp-tabs [aria-current="page"]');
      if (!tab) return;
      const tabs = tab.closest('.wp-tabs');
      tabs.scrollLeft = tab.getBoundingClientRect().left - tabs.getBoundingClientRect().left - 16;
    })();
  </script>
{%- endif -%}
