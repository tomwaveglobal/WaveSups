{%- doc -%}
  Wraps Shopify's own policy markup (/policies/*) in the Wave FY27 look:
  hero with the policy title and tabs for every published policy, then an
  "On this page" contents list (built by the script below from the policy's
  headings) and a contact card. Styles: assets/wave-policy.css.

  Rendered twice from layout/theme.liquid, around content_for_layout.

  @param {string} part - 'start' (before the policy) or 'end' (after it)
{%- enddoc -%}

{%- liquid
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
-%}

{%- if part == 'start' -%}
  {%- liquid
    assign current_title = page_title
    for policy in shop.policies
      if request.path contains policy.url
        assign current_title = policy.title
      endif
    endfor

    assign words = current_title | escape | split: ' '
    if words.size > 1
      assign last_word = words | last
      assign lead_size = words.size | minus: 1
      assign lead = words | slice: 0, lead_size | join: ' '
      assign title_html = lead | append: ' <em>' | append: last_word | append: '</em>'
    else
      assign title_html = '<em>' | append: words.first | append: '</em>'
    endif
  -%}
  <div class="wp">
    <div class="wp-hero">
      <div class="wp__inner">
        <p class="wp-eyebrow">Policies</p>
        <h1 class="wp-title">
          {%- render 'highlighted-text', content: title_html, style: 'scribble', scribble: 'basic-underline' -%}
        </h1>
        <p class="wp-lede">The small print for shopping with {{ shop.name | escape }}, written to be clear.</p>

        {%- if shop.policies.size > 1 -%}
          <nav aria-label="Policies">
            <ul class="wp-tabs" role="list">
              {%- for policy in shop.policies -%}
                <li>
                  <a
                    href="{{ policy.url }}"
                    {% if request.path contains policy.url %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- policy.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    </div>
    <div class="wp-policy">
{%- else -%}
    </div>

    <div class="wp-help">
      <div class="wp__inner">
        <div class="wp-help__card">
          <div>
            <h2 class="wp-help__title">Still got a <em>question?</em></h2>
            <p class="wp-help__text">
              If something here isn't clear, our support team will talk you through it.
            </p>
          </div>
          <a class="wp-help__button" href="{{ root }}/pages/contact-us">
            Contact us
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      // Keep the current policy's tab in view when the tabs scroll sideways
      const tab = document.querySelector('.wp-tabs [aria-current="page"]');
      if (tab) {
        const tabs = tab.closest('.wp-tabs');
        tabs.scrollLeft = tab.getBoundingClientRect().left - tabs.getBoundingClientRect().left - 16;
      }

      const container = document.querySelector('.wp-policy .shopify-policy__container');
      const rte = container && container.querySelector('.shopify-policy__body .rte');
      if (!rte) return;

      // Section headings: h2s, else h3s, else bold-only paragraphs ("4 YOUR STATUS")
      let heads = [...rte.querySelectorAll('h2')];
      if (heads.length < 2) heads = [...rte.querySelectorAll('h3')];
      if (heads.length < 2) {
        heads = [...rte.querySelectorAll('h4, h5, h6, p')].filter((p) => {
          if (p.tagName !== 'P') return true;
          const b = p.firstElementChild;
          const text = p.textContent.trim();
          return b && p.children.length === 1 && /^(STRONG|B)$/.test(b.tagName) &&
            text === b.textContent.trim() && text.length > 0 && text.length < 90;
        });
      }
      heads.forEach((h) => h.classList.add('wp-sec'));
      if (heads.length < 3) return;

      const used = {};
      const toc = document.createElement('details');
      toc.className = 'wp-toc';
      toc.open = window.matchMedia('(min-width: 1024px)').matches;
      toc.innerHTML = '<summary>On this page</summary><ol role="list"></ol>';
      const list = toc.querySelector('ol');
      const links = heads.map((h) => {
        let label = h.textContent.replace(/\s+/g, ' ').trim();
        if (label === label.toUpperCase()) {
          label = label.toLowerCase().replace(/[a-z]/, (c) => c.toUpperCase());
        }
        let id = h.id || 'wp-' + (label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 48) || 'section');
        while (used[id] || (!h.id && document.getElementById(id))) id += '-2';
        used[id] = true;
        h.id = id;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + id;
        a.textContent = label;
        a.addEventListener('click', () => {
          if (!window.matchMedia('(min-width: 1024px)').matches) toc.open = false;
        });
        li.appendChild(a);
        list.appendChild(li);
        return a;
      });
      container.prepend(toc);
      container.classList.add('wp-has-toc');

      if (!('IntersectionObserver' in window)) return;
      const visible = new Set();
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
        const first = heads.find((h) => visible.has(h));
        if (!first) return;
        links.forEach((a, i) => a.classList.toggle('is-active', heads[i] === first));
      }, { rootMargin: '0px 0px -55% 0px' });
      heads.forEach((h) => io.observe(h));
    })();
  </script>
{%- endif -%}
