{%- comment -%}
  "What fits this board" — accessories compatible with the current product, shown as category tiles
  (icon, fitting spec, number of options) that switch between panels of product cards.

  Data, in order of preference:
  1. product.metafields.custom.fitting_standards — a list of `fitting_standard` metaobjects, each with:
       category    (single line text, e.g. "Fins")       — becomes the tile / tab
       spec        (single line text, e.g. "US fin box") — shown on the tile and in the panel
       note        (multi-line text, optional)           — fitting advice shown in the panel
       accessories (list of products)                    — the compatible products
  2. Otherwise, the "Accessory group" blocks set in the theme editor. A block with "Only show on"
     products set is skipped on every other product.

  Entries sharing a category / tab title merge into one tab, in the order first seen.
  Renders nothing on the storefront when there is nothing to show.
{%- endcomment -%}

{%- liquid
  assign standards = product.metafields.custom.fitting_standards.value
  assign use_metafield = false
  if standards != blank and standards.size > 0
    assign use_metafield = true
    assign entries = standards
  else
    assign entries = section.blocks
  endif

  assign product_key = '|' | append: product.id | append: '|'
  assign board_name = product.title | split: ' | ' | first

  comment
    Pass 1: which entries apply to this product, and the ordered list of tab titles.
  endcomment
  assign ok_list = '|'
  assign cat_list = '^^'
  for entry in entries
    if use_metafield
      assign e_title = entry.category.value | default: entry.name.value
    else
      assign e_title = entry.settings.title
      if entry.settings.boards != blank
        assign board_ids = entry.settings.boards | map: 'id' | join: '|'
        assign board_ids = '|' | append: board_ids | append: '|'
        unless board_ids contains product_key
          continue
        endunless
      endif
    endif
    assign e_title = e_title | default: 'Accessories' | strip
    assign ok_list = ok_list | append: forloop.index0 | append: '|'
    assign cat_key = '^^' | append: e_title | append: '^^'
    unless cat_list contains cat_key
      assign cat_list = cat_list | append: e_title | append: '^^'
    endunless
  endfor
  assign categories = cat_list | remove_first: '^^' | split: '^^'
-%}

{%- if categories.size > 0 -%}
  {%- comment -%}
    Pass 2: build the tiles and panels for each tab. Products are looped per entry rather than
    merged with concat, which doesn't accept product_list settings.
  {%- endcomment -%}
  {%- capture tabs_html -%}{%- endcapture -%}
  {%- capture indicators_html -%}{%- endcapture -%}
  {%- capture panels_html -%}{%- endcapture -%}

  {%- for group_title in categories -%}
    {%- liquid
      assign idx = forloop.index0
      assign is_first = forloop.first
      assign group_spec = ''
      assign group_note = ''
      assign group_attrs = ''

      for entry in entries
        assign ok_key = '|' | append: forloop.index0 | append: '|'
        unless ok_list contains ok_key
          continue
        endunless

        if use_metafield
          assign e_title = entry.category.value | default: entry.name.value | default: 'Accessories' | strip
          assign e_spec = entry.spec.value
          assign e_note = entry.note.value
        else
          assign e_title = entry.settings.title | default: 'Accessories' | strip
          assign e_spec = entry.settings.spec
          assign e_note = entry.settings.note
        endif

        if e_title != group_title
          continue
        endif

        if e_spec != blank
          unless group_spec contains e_spec
            if group_spec != blank
              assign group_spec = group_spec | append: ' / '
            endif
            assign group_spec = group_spec | append: e_spec
          endunless
        endif
        if e_note != blank
          assign group_note = group_note | append: ' ' | append: e_note
        endif
        if group_attrs == blank and use_metafield == false
          assign group_attrs = entry.shopify_attributes
        endif
      endfor

      assign group_note = group_note | strip
      assign panel_id = 'CompatPanel-' | append: section.id | append: '-' | append: idx
      assign slider_id = 'CompatSlider-' | append: section.id | append: '-' | append: idx
      assign seen = '|'
      assign shown = 0
    -%}

    {%- capture cards -%}
      {%- for entry in entries -%}
        {%- liquid
          assign ok_key = '|' | append: forloop.index0 | append: '|'
          unless ok_list contains ok_key
            continue
          endunless
          if use_metafield
            assign e_title = entry.category.value | default: entry.name.value | default: 'Accessories' | strip
            assign e_products = entry.accessories.value
          else
            assign e_title = entry.settings.title | default: 'Accessories' | strip
            assign e_products = entry.settings.products
          endif
          if e_title != group_title
            continue
          endif
        -%}
        {%- for accessory in e_products -%}
          {%- liquid
            assign seen_key = '|' | append: accessory.id | append: '|'
            if accessory == blank or accessory.id == product.id or seen contains seen_key
              continue
            endif
            if section.settings.hide_sold_out and accessory.available == false
              continue
            endif
            if shown >= section.settings.product_limit
              break
            endif
            assign seen = seen | append: accessory.id | append: '|'
            assign shown = shown | plus: 1
          -%}
          {%- render 'product-card',
            product: accessory,
            product_id: accessory.id,
            section_id: section.id,
            block_id: idx,
            image_ratio: settings.product_image_ratio,
            image_fill: settings.product_image_fill,
            show_secondary_image: settings.product_secondary_image,
            show_multiple_images: settings.product_multiple_images,
            show_vendor: false,
            title_truncation: settings.product_title_truncation,
            title_line_limit: settings.product_title_line_limit,
            show_rating: settings.product_rating,
            show_color_swatches: settings.product_color_swatches,
            show_countdown: false,
            show_quick_add: settings.product_quick_add,
            show_quick_view: settings.product_quick_view,
            vertical_badges: settings.product_vertical_badges,
            show_sold_out: settings.product_sold_out,
            show_save_amount: settings.product_save_amount,
            save_type: settings.product_save_type,
            show_icon_list: false
          -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- capture tab -%}
      <button class="compat-tile" type="button" role="tab" aria-controls="{{ panel_id }}" data-index="{{ idx }}"{% if is_first %} disabled aria-selected="true"{% else %} aria-selected="false"{% endif %} {{ group_attrs }}>
        <span class="compat-tile__icon">{%- render 'compat-icon', name: group_title -%}</span>
        <span class="compat-tile__text">
          <span class="compat-tile__label">{{ group_title | escape }}</span>
          <span class="compat-tile__value">
            {%- if section.settings.show_specs and group_spec != blank -%}
              {{- group_spec | escape -}}
            {%- else -%}
              {{- shown }} {% if shown == 1 %}option{% else %}options{% endif -%}
            {%- endif -%}
          </span>
        </span>
        {%- if section.settings.show_specs and group_spec != blank -%}
          <span class="compat-tile__count" aria-label="{{ shown }} compatible">{{ shown }}</span>
        {%- endif -%}
      </button>
    {%- endcapture -%}
    {%- assign tabs_html = tabs_html | append: tab -%}

    {%- if section.settings.carousel_on_desktop -%}
      {%- capture indicator -%}
        <div class="indicators compat-arrows hidden lg:flex gap-2"{% unless is_first %} hidden{% endunless %} data-index="{{ idx }}">
          <button class="button button--secondary" type="button" is="previous-button" aria-controls="{{ slider_id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'chevron-left', class: 'transform' -%}
            </span>
          </button>
          <button class="button button--secondary" type="button" is="next-button" aria-controls="{{ slider_id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'chevron-right', class: 'transform' -%}
            </span>
          </button>
        </div>
      {%- endcapture -%}
      {%- assign indicators_html = indicators_html | append: indicator -%}
    {%- endif -%}

    {%- capture panel -%}
      <div id="{{ panel_id }}" class="compat-panel" role="tabpanel"{% unless is_first %} hidden{% endunless %}>
        <div class="compat-panel__intro">
          <span class="compat-fits">
            {%- render 'icon', icon: 'check-circle-filled' -%}
            <span>{{- section.settings.fits_label | default: 'Fits the' | escape }} <strong>{{ board_name | escape }}</strong></span>
          </span>
          {%- if group_spec != blank -%}
            <span class="compat-panel__spec">{{ group_title | escape }} · {{ group_spec | escape }}</span>
          {%- endif -%}
          {%- if group_note != blank -%}
            <p class="compat-panel__note">{%- render 'icon', icon: 'info' -%}<span>{{ group_note | escape | newline_to_br }}</span></p>
          {%- endif -%}
        </div>

        {%- if shown > 0 -%}
          <slider-element id="{{ slider_id }}" class="compat-cards grid slider{% if section.settings.carousel_on_desktop %} slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}" selector=".card-grid>.card"{% if section.settings.carousel_on_desktop or section.settings.swipe_on_mobile %} tabindex="0"{% endif %}>
            <motion-list class="product-grid card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
              {{- cards -}}
            </motion-list>
          </slider-element>
        {%- elsif request.design_mode -%}
          <p class="compat-panel__empty">No products picked for this tab yet. Add them in the block settings, or in the product's fitting standards.</p>
        {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- assign panels_html = panels_html | append: panel -%}
  {%- endfor -%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  /* Wave brand tokens — same palette as the FY27 sections on Wave Spas (wave-fy27.css):
     black / white, soft grey panels, amber accent. */
  #shopify-section-{{ section.id }} .compat {
    --c-ink: #000;
    --c-ink-2: #3f3f46;
    --c-muted: #71717a;
    --c-line: rgba(0, 0, 0, 0.1);
    --c-panel: #fafafa;
    --c-surface: #fff;
    --c-accent: #f59e0b;
    --c-accent-ink: #b45309;
    --c-active-bg: #000;
    --c-active-ink: #fff;
    --color-highlight: 245 158 11;
    --c-radius: var(--rounded-block, 20px);
    --c-radius-card: var(--rounded-card, 16px);
    --c-ease: cubic-bezier(0.22, 1, 0.36, 1);
    /* own stacking layer: the product-videos app leaves a fixed modal over the page
       that hides unpositioned content */
    position: relative;
    z-index: 1;
    isolation: isolate;
    color: var(--c-ink);
    background: var(--c-panel);
    border-radius: var(--c-radius);
    padding: clamp(28px, 4.5vw, 64px) clamp(16px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .compat--white { --c-panel: #fff; --c-surface: #fafafa; }
  #shopify-section-{{ section.id }} .compat--dark {
    --c-ink: #fff;
    --c-ink-2: rgba(255, 255, 255, 0.82);
    --c-muted: rgba(255, 255, 255, 0.6);
    --c-line: rgba(255, 255, 255, 0.16);
    --c-panel: #000;
    --c-surface: rgba(255, 255, 255, 0.06);
    --c-accent-ink: #f59e0b;
    --c-active-bg: #fff;
    --c-active-ink: #000;
  }
  #shopify-section-{{ section.id }} .page-width--full .compat { border-radius: 0; }

  /* Header */
  #shopify-section-{{ section.id }} .compat__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
    margin-block-end: clamp(28px, 3.5vw, 44px);
  }
  #shopify-section-{{ section.id }} .compat__intro { max-width: 44rem; }
  #shopify-section-{{ section.id }} .compat__eyebrow {
    margin: 0 0 16px;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    color: var(--c-accent-ink);
  }
  #shopify-section-{{ section.id }} .compat__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--font-heading-letter-spacing);
    font-size: var(--title-md);
    line-height: 1.05;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .compat__title em { font-style: normal; }
  #shopify-section-{{ section.id }} .compat__desc {
    max-width: 44ch;
    margin-top: 20px;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--c-ink-2);
  }
  #shopify-section-{{ section.id }} .compat__desc p { margin: 0; }

  /* "Showing parts for" board badge */
  #shopify-section-{{ section.id }} .compat__board {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 22px 8px 8px;
    border-radius: 999px;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
  }
  #shopify-section-{{ section.id }} .compat__board img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: contain;
    background: #fff;
    padding: 4px;
  }
  #shopify-section-{{ section.id }} .compat__board-text { display: grid; gap: 4px; line-height: 1.15; }
  #shopify-section-{{ section.id }} .compat__board-text small { font-size: var(--text-sm); color: var(--c-muted); }
  #shopify-section-{{ section.id }} .compat__board-text strong { font-size: 1rem; font-weight: 700; }

  /* Category tiles (these are the tabs) */
  #shopify-section-{{ section.id }} .compat__nav { display: flex; align-items: stretch; gap: 16px; }
  #shopify-section-{{ section.id }} .compat__tiles {
    flex: 1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(190px, 1fr);
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 4px;
    margin: -4px;
  }
  #shopify-section-{{ section.id }} .compat__tiles::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .compat-tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 18px;
    text-align: start;
    color: var(--c-ink);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--c-radius-card);
    scroll-snap-align: start;
    cursor: pointer;
    opacity: 1;
    backdrop-filter: none;
    transition: transform 0.4s var(--c-ease), background-color 0.25s, border-color 0.25s, color 0.25s;
  }
  #shopify-section-{{ section.id }} .compat-tile:hover { transform: translateY(-2px); border-color: var(--c-ink); }
  #shopify-section-{{ section.id }} .compat-tile:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  #shopify-section-{{ section.id }} .compat-tile[disabled] {
    cursor: default;
    opacity: 1;
    transform: none;
    color: var(--c-active-ink);
    background: var(--c-active-bg);
    border-color: var(--c-active-bg);
  }
  #shopify-section-{{ section.id }} .compat-tile__icon { flex-shrink: 0; color: var(--c-accent); line-height: 0; }
  #shopify-section-{{ section.id }} .compat-icon { width: 34px; height: 34px; }
  #shopify-section-{{ section.id }} .compat-tile__text { display: grid; gap: 4px; min-width: 0; }
  #shopify-section-{{ section.id }} .compat-tile__label { font-size: var(--text-sm); font-weight: 500; line-height: 1.2; color: var(--c-muted); }
  #shopify-section-{{ section.id }} .compat-tile[disabled] .compat-tile__label { color: inherit; opacity: 0.7; }
  #shopify-section-{{ section.id }} .compat-tile__value {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #shopify-section-{{ section.id }} .compat-tile__count {
    position: absolute;
    top: 10px;
    inset-inline-end: 10px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-ink);
    background: var(--c-line);
  }
  #shopify-section-{{ section.id }} .compat-tile[disabled] .compat-tile__count { color: #000; background: var(--c-accent); }

  #shopify-section-{{ section.id }} .compat-arrows { align-items: center; }
  #shopify-section-{{ section.id }} .compat-arrows .button { padding: 14px; }

  /* Panels */
  #shopify-section-{{ section.id }} .compat-panel__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-block: clamp(24px, 3vw, 36px) 20px;
  }
  #shopify-section-{{ section.id }} .compat-fits {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px 8px 10px;
    border-radius: 999px;
    font-size: var(--text-sm);
    color: var(--c-active-ink);
    background: var(--c-active-bg);
  }
  #shopify-section-{{ section.id }} .compat-fits .icon { width: 20px; height: 20px; color: var(--c-accent); }
  #shopify-section-{{ section.id }} .compat-fits strong { font-weight: 700; }
  #shopify-section-{{ section.id }} .compat-panel__spec { font-size: var(--text-sm); color: var(--c-muted); }
  #shopify-section-{{ section.id }} .compat-panel__note {
    flex-basis: 100%;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--c-ink-2);
  }
  #shopify-section-{{ section.id }} .compat-panel__note .icon { width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px; color: var(--c-accent); }
  #shopify-section-{{ section.id }} .compat-panel__empty { color: var(--c-muted); }

  /* Product cards: theme cards on white, with a "Fits" tag */
  #shopify-section-{{ section.id }} .compat-cards {
    --color-foreground: 0 0 0;
    --color-background: 255 255 255;
    --color-placeholder: 255 255 255;
    color: #000;
  }
  #shopify-section-{{ section.id }} .compat-cards .product-card {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--c-radius-card);
    overflow: hidden;
    transition: transform 0.5s var(--c-ease), box-shadow 0.5s var(--c-ease);
  }
  #shopify-section-{{ section.id }} .compat-cards .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -24px rgba(0, 0, 0, 0.35);
  }
  #shopify-section-{{ section.id }} .compat-cards .product-card__media::after {
    content: '✓ {{ section.settings.card_tag | default: 'Fits' | escape }}';
    position: absolute;
    bottom: 12px;
    inset-inline-start: 12px;
    z-index: 2;
    padding: 5px 11px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #000;
    background: var(--c-accent);
    pointer-events: none;
  }

  /* Help strip */
  #shopify-section-{{ section.id }} .compat__help {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block-start: clamp(28px, 3.5vw, 44px);
    padding: 16px 20px;
    border-radius: var(--c-radius-card);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
  }
  #shopify-section-{{ section.id }} .compat__help .icon { width: 22px; height: 22px; color: var(--c-accent); flex-shrink: 0; }
  #shopify-section-{{ section.id }} .compat__help p { margin: 0; color: var(--c-ink-2); }
  #shopify-section-{{ section.id }} .compat__help a {
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .compat__board { width: 100%; }
    #shopify-section-{{ section.id }} .compat__tiles { grid-auto-columns: 70%; }
    #shopify-section-{{ section.id }} .compat-tile { padding: 14px; }
    #shopify-section-{{ section.id }} .compat-icon { width: 28px; height: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .compat-tile,
    #shopify-section-{{ section.id }} .compat-cards .product-card { transition: none; }
    #shopify-section-{{ section.id }} .compat-tile:hover,
    #shopify-section-{{ section.id }} .compat-cards .product-card:hover { transform: none; }
  }
</style>

<div class="section section--padding">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %}">
    <div class="compat compat--{{ section.settings.style | default: 'soft' }}">

      <div class="compat__head">
        <div class="compat__intro">
          {%- if section.settings.subheading != blank -%}
            <p class="compat__eyebrow">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="compat__title">
              {%- render 'highlighted-text', content: section.settings.heading, style: 'scribble', scribble: section.settings.heading_scribble -%}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="compat__desc">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.show_board -%}
          <div class="compat__board">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 52, height: 52 }}
            {%- endif -%}
            <span class="compat__board-text">
              <small>{{ section.settings.board_label | default: 'Showing parts for' | escape }}</small>
              <strong>{{ board_name | escape }}</strong>
            </span>
          </div>
        {%- endif -%}
      </div>

      <tabs-element id="CompatTabs-{{ section.id }}" class="compat__nav">
        <div class="compat__tiles" role="tablist" aria-label="{{ 'Accessory types' }}">
          {{- tabs_html -}}
        </div>
        {{- indicators_html -}}
      </tabs-element>

      {{- panels_html -}}

      {%- if section.settings.help_text != blank -%}
        <div class="compat__help">
          {%- render 'icon', icon: 'comment' -%}
          <div class="rte">{{ section.settings.help_text }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const tabs = document.getElementById('CompatTabs-{{ section.id }}');
    if (!tabs) return;
    // TabsElement toggles [disabled] on the active tile; mirror it to aria-selected and keep the
    // active tile scrolled into view on mobile.
    new MutationObserver(() => {
      tabs.querySelectorAll('[role="tab"]').forEach((tile) => {
        tile.setAttribute('aria-selected', tile.disabled ? 'true' : 'false');
        if (tile.disabled) tile.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
      });
    }).observe(tabs, { attributes: true, attributeFilter: ['selected-index'] });
  })();
</script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding-block: 2rem; text-align: center; opacity: 0.7;">
    <p><strong>What fits this board</strong> — nothing to show for this product. Add "Accessory group" blocks, or fill the product's <code>custom.fitting_standards</code> metafield.</p>
  </div>
{%- endif -%}

