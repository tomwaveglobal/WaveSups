  "settings": [
    {
      "type": "paragraph",
      "content": "Shows accessories compatible with the current product. If the product has a custom.fitting_standards metafield (list of 'Fitting standard' metaobjects) that is used; otherwise the Accessory group blocks below are used (each can be limited to specific products)."
    },
    {
      "type": "select",
      "id": "style",
