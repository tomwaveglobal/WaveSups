{%- comment -%}
  Compatible accessories V2 — the Featured collections layout (heading, pill tabs, product cards)
  filled from the viewed product's custom.compatible_accessories metafield (list of products).

  Each accessory goes under the tab named in its own custom.accessory_tab metafield, falling back to
  its product type. Tabs follow the "Tab order" setting; any others follow in the order first seen.
  Renders nothing when the product has no compatible accessories.
{%- endcomment -%}

{%- liquid
  assign accessories = product.metafields.custom.compatible_accessories.value

  assign present = '^^'
  for accessory in accessories
    assign tab = accessory.metafields.custom.accessory_tab.value | default: accessory.type | default: 'Accessories' | strip
    assign tab_key = '^^' | append: tab | append: '^^'
    unless present contains tab_key
      assign present = present | append: tab | append: '^^'
    endunless
  endfor

  assign tab_list = '^^'
  assign preferred = section.settings.tab_order | split: ','
  for item in preferred
    assign wanted = item | strip
    assign tab_key = '^^' | append: wanted | append: '^^'
    if wanted != blank and present contains tab_key
      assign tab_list = tab_list | append: wanted | append: '^^'
    endif
  endfor
  assign present_tabs = present | remove_first: '^^' | split: '^^'
  for tab in present_tabs
    assign tab_key = '^^' | append: tab | append: '^^'
    unless tab_list contains tab_key
      assign tab_list = tab_list | append: tab | append: '^^'
    endunless
  endfor

  assign tabs = tab_list | remove_first: '^^' | split: '^^'
-%}

{%- if tabs.size > 0 -%}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
  #shopify-section-{{ section.id }} .tab__item .compat-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: {{ section.settings.icon_color | default: '#f59e0b' }};
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- render 'section-heading', section: section -%}

    <div id="CompatV2Tabs-{{ section.id }}" class="tab-list flex gap-6 justify-between">
      <scroll-shadow class="scroll-shadow grid overflow-hidden">
        <div class="scroll-area grid">
          <div class="flex gap-4" role="tablist">
            {%- for tab_title in tabs -%}
              <button class="tab__item button icon-with-text{% if forloop.first %} button--primary{% else %} button--secondary{% endif %} whitespace-nowrap"{% if forloop.first %} disabled{% endif %} type="button" is="hover-button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="CompatV2Panel-{{ section.id }}-{{ forloop.index0 }}">
                <span class="btn-fill" data-fill></span>
                <span class="btn-text">
                  {%- if section.settings.show_icons -%}{%- render 'compat-icon', name: tab_title -%}{%- endif -%}
                  {{- tab_title | escape -}}
                </span>
              </button>
            {%- endfor -%}
          </div>
        </div>
        <template>
          <slot></slot>
          <s dir="{% render 'direction' %}" style="--t: 0;--b: 0;--l: 0;--r: 0;">
            <span class="l"></span>
            <span class="r"></span>
          </s>
          <style>
            :host{display:inline-block;position:relative}:host([hidden]){display:none}
            s{position:absolute;inset:0;pointer-events:none;{% if settings.card_style == 'card' %}--color-background:var(--color-placeholder){% endif %}}
            s span{position:absolute;inset-block:0;width:var(--sp-12);opacity:0;transition:opacity var(--animation-short);}
            s .l{inset-inline-start:0;opacity:var(--l);background:linear-gradient(90deg,rgb(var(--color-background)) 0%,transparent 100%);}
            s .r{inset-inline-end:0;opacity:var(--r);background:linear-gradient(270deg,rgb(var(--color-background)) 0%,transparent 100%);}
            s[dir=rtl] :is(.icon-chevron-left,.icon-chevron-right){transform:scaleX(-1);}
          </style>
        </template>
      </scroll-shadow>

      {%- if section.settings.carousel_on_desktop -%}
        {%- for tab_title in tabs -%}
          <div class="indicators hidden lg:flex gap-2d5"{% unless forloop.first %} hidden{% endunless %}>
            <button class="button button--secondary" type="button" is="previous-button" aria-controls="CompatV2Slider-{{ section.id }}-{{ forloop.index0 }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'icon', icon: 'chevron-left', class: 'transform' -%}
              </span>
            </button>
            <button class="button button--secondary" type="button" is="next-button" aria-controls="CompatV2Slider-{{ section.id }}-{{ forloop.index0 }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'icon', icon: 'chevron-right', class: 'transform' -%}
              </span>
            </button>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- for tab_title in tabs -%}
      {%- assign tab_index = forloop.index0 -%}
      {%- assign seen = '|' -%}
      {%- assign shown = 0 -%}
      <div id="CompatV2Panel-{{ section.id }}-{{ tab_index }}" role="tabpanel"{% unless forloop.first %} hidden{% endunless %}>
        <slider-element id="CompatV2Slider-{{ section.id }}-{{ tab_index }}" class="grid slider{% if section.settings.carousel_on_desktop %} slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}" selector=".card-grid>.card"{% if section.settings.carousel_on_desktop or section.settings.swipe_on_mobile %} tabindex="0"{% endif %}>
          <motion-list motion-reduced class="product-grid card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
              {%- for accessory in accessories -%}
                {%- liquid
                  assign tab = accessory.metafields.custom.accessory_tab.value | default: accessory.type | default: 'Accessories' | strip
                  if tab != tab_title
                    continue
                  endif
                  assign seen_key = '|' | append: accessory.id | append: '|'
                  if accessory.id == product.id or seen contains seen_key
                    continue
                  endif
                  if shown >= section.settings.product_limit
                    break
                  endif
                  assign seen = seen | append: accessory.id | append: '|'
                  assign shown = shown | plus: 1
                -%}
                {%- render 'product-card',
                  product: accessory,
                  product_id: accessory.id,
                  section_id: section.id,
                  block_id: tab_index,
                  image_ratio: settings.product_image_ratio,
                  image_fill: settings.product_image_fill,
                  show_secondary_image: settings.product_secondary_image,
                  show_multiple_images: settings.product_multiple_images,
                  show_vendor: settings.product_vendor,
                  title_truncation: settings.product_title_truncation,
                  title_line_limit: settings.product_title_line_limit,
                  show_rating: settings.product_rating,
                  show_color_swatches: settings.product_color_swatches,
                  show_countdown: settings.product_countdown,
                  show_quick_add: section.settings.quick_add,
                  show_quick_view: section.settings.quick_add,
                  vertical_badges: settings.product_vertical_badges,
                  show_sold_out: settings.product_sold_out,
                  show_save_amount: settings.product_save_amount,
                  save_type: settings.product_save_type,
                  show_icon_list: settings.product_icon_list
                -%}
              {%- endfor -%}
          </motion-list>
        </slider-element>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (() => {
    // Plain show/hide switching (the theme's tabs-element slides panels in, which reads as a bounce).
    const nav = document.getElementById('CompatV2Tabs-{{ section.id }}');
    if (!nav) return;
    const tabs = Array.from(nav.querySelectorAll('[role="tab"]'));
    const indicators = Array.from(nav.querySelectorAll('.indicators'));

    const select = (index) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.disabled = active;
        tab.classList.toggle('button--primary', active);
        tab.classList.toggle('button--secondary', !active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        const panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !active;
      });
      indicators.forEach((group, i) => {
        group.hidden = i !== index;
        if (i === index) {
          group.querySelectorAll('button').forEach((button) => {
            if (typeof button.unload === 'function') button.unload();
            if (typeof button.load === 'function') button.load();
          });
        }
      });
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));
  })();
</script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding-block: 2rem; text-align: center; opacity: 0.7;">
    <p><strong>Compatible accessories</strong> — this product has no compatible accessories yet. Add them in Shopify admin under the product's <em>Compatible accessories</em> metafield.</p>
  </div>
{%- endif -%}

